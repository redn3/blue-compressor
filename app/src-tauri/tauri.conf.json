{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blue Compressor",
  "version": "0.1.6",
  "identifier": "org.bluecompressor.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Blue Compressor",
        "width": 1080,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0c0e13",
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Recompress Nikon N-RAW and R3D NE TICO RAW clips",
    "longDescription": "Blue Compressor repacks, requantizes or resizes Nikon N-RAW (.NEV) and R3D NE (.R3D) clips while keeping the raw data, metadata, audio and container.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "nev",
          "NEV",
          "r3d",
          "R3D"
        ],
        "name": "Nikon raw clip",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "copyright": "Copyright 2026 Blue Compressor contributors. Licensed under the Apache License 2.0.",
    "license": "Apache-2.0",
    "resources": {
      "../../LICENSE": "licenses/LICENSE",
      "../../NOTICE": "licenses/NOTICE",
      "../../LICENSES/rawmakase-MIT.txt": "licenses/rawmakase-MIT.txt"
    }
  }
}
